+/* 6.9.2 — premium print data-bars and macro-level grouping. */
+.report-meter{position:relative;isolation:isolate;min-height:4.4mm;display:grid;place-items:center;overflow:hidden;border-radius:1.1mm;background:#f1f5f6;border:1px solid rgba(15,52,66,.14);font-variant-numeric:tabular-nums}.report-meter>i{position:absolute;z-index:-1;right:0;top:0;bottom:0;min-width:0;opacity:.72;border-left:1px solid rgba(0,0,0,.07)}.report-meter>b{position:relative;z-index:1;font-weight:1000;color:#102f3a;text-shadow:0 1px rgba(255,255,255,.7)}
+.report-meter.tone-very-low>i{background:linear-gradient(90deg,#e5e7eb,#cbd5e1)}.report-meter.tone-low>i{background:linear-gradient(90deg,#ffd1d7,#ea5268)}.report-meter.tone-mid>i{background:linear-gradient(90deg,#ffe0b3,#f59e0b)}.report-meter.tone-good>i{background:linear-gradient(90deg,#fff3a8,#e5cf1a)}.report-meter.tone-excellent>i{background:linear-gradient(90deg,#c9f2b2,#68b94b)}.report-meter.tone-na>i{display:none}.report-meter.total{border-width:1.4px;background:#eaf2f4}.report-meter.compact{min-height:3.8mm;border-radius:.8mm}.report-meter.score{min-width:19mm}
+.grade-matrix-value{padding:.38mm!important;background:#fff!important}.grade-matrix-value.total{background:#edf5f6!important}.grade-matrix-total-label{font-size:5.3px;font-weight:900;color:#50626b}.dept-metric-cell{padding:.35mm!important;background:#fff!important}.dept-grade-total .dept-metric-cell{background:#eef1f3!important}.dept-stats-table tfoot .dept-metric-cell{background:#dff3bc!important}
