rid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem}.sr69-teacher-grid>div{padding:.72rem;border:1px solid #e5ecee;border-radius:12px;background:linear-gradient(180deg,#fff,#f8fbfb)}.sr69-teacher-grid b,.sr69-teacher-grid strong,.sr69-teacher-grid small{display:block}.sr69-teacher-grid b{font-size:.76rem;color:#30525f}.sr69-teacher-grid strong{margin-top:.28rem;font-size:1.15rem;color:#138b7f}.sr69-teacher-grid small{margin-top:.18rem;color:#8a9aa1;font-size:.61rem}.sr69-students{display:grid;gap:.5rem}.sr69-students button{display:flex;align-items:center;justify-content:space-between;gap:.8rem;border:1px solid #e4ebed;border-radius:11px;background:#fbfcfc;padding:.65rem;text-align:right}.sr69-students b{display:block;color:#244b59;font-size:.75rem}.sr69-students small{display:block;color:#899aa1;font-size:.61rem;margin-top:.12rem}.sr69-students strong{color:#c14f62}.sr69-empty{padding:1rem;color:#8a999f;text-align:center;font-size:.78rem}.sr69-heatmap th,.sr69-heatmap td{font-size:.72rem}.report-coordinator{grid-column:1/-1!important;background:#f7fafb!important}
+@media(max-width:1350px){.sr69-kpi-strip{grid-template-columns:repeat(3,minmax(0,1fr))}.sr69-top-charts,.sr69-mid-grid,.sr69-bottom-grid{grid-template-columns:1fr}.sr69-grade-panel{min-height:360px}}
+@media(max-width:980px){.sr69-command-hero{grid-template-columns:1fr}.sr69-filterbar{position:relative;top:auto;grid-template-columns:repeat(2,minmax(0,1fr))}.sr69-filterbar .reset{grid-column:1/-1}.sr69-kpi-strip{grid-template-columns:repeat(2,minmax(0,1fr))}}
+@media(max-width:620px){.sr69-command-hero{padding:1.1rem;border-radius:20px}.sr69-kpi-strip{grid-template-columns:1fr}.sr69-filterbar{grid-template-columns:1fr}.sr69-teacher-grid{grid-template-columns:1fr}.sr69-readiness-list{grid-template-columns:1fr}.sr69-bars{overflow-x:auto}.sr69-bar-row{min-width:580px}.sr69-chart-labels{grid-template-columns:repeat(2,1fr)}.sr69-grade-bars{overflow-x:auto}.sr69-grade-bars article{min-width:100px}.sr69-sidebar-actions{grid-template-columns:1fr}}
+@media print{.sr69-dashboard{display:none!important}}
