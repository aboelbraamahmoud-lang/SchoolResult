6.7px;font-weight:1000}.level-overview b{font-size:14px;line-height:1;margin-top:.7mm;color:#163846}.level-overview small{font-size:5.5px;margin-top:.5mm;color:#657781}.level-overview-bar{height:1.3mm;background:#e6ecef;border-radius:99px;overflow:hidden;margin-top:1mm}.level-overview-bar i{display:block;height:100%;border-radius:inherit}.level-overview article.macro-above{border-top:2.2mm solid #27935a}.level-overview article.macro-average{border-top:2.2mm solid #d8a61c}.level-overview article.macro-below{border-top:2.2mm solid #d45566}.level-overview article.macro-above .level-overview-bar i{background:#27935a}.level-overview article.macro-average .level-overview-bar i{background:#d8a61c}.level-overview article.macro-below .level-overview-bar i{background:#d45566}
+.level-analysis-table .level-group-head.macro-above th{background:#dff4e7;color:#174c2d;border-top:2px solid #27935a}.level-analysis-table .level-group-head.macro-average th{background:#fff3c8;color:#654e08;border-top:2px solid #d8a61c}.level-analysis-table .level-group-head.macro-below th{background:#fde3e7;color:#702836;border-top:2px solid #d45566}.level-group-dot{display:inline-block;width:2.1mm;height:2.1mm;border-radius:50%;margin-left:1.3mm;vertical-align:-.3mm;background:currentColor}.level-analysis-table .level-row.macro-above td:first-child{border-right:2px solid #27935a}.level-analysis-table .level-row.macro-average td:first-child{border-right:2px solid #d8a61c}.level-analysis-table .level-row.macro-below td:first-child{border-right:2px solid #d45566}.level-score-visual,.level-percent-visual{padding:.35mm!important;min-width:22mm}.level-macro-badge{display:inline-grid;gap:.2mm;min-width:21mm;padding:.6mm 1.2mm;border-radius:99px;font-size:6.1px;font-weight:1000;line-height:1.1}.level-macro-badge small{font-size:4.8px;font-weight:700;opacity:.72}.level-macro-badge.macro-above{background:#e0f4e7;color:#17613a;border:1px solid #8bd0a6}.level-macro-badge.macro-average{background:#fff3c8;color:#6a5207;border:1px solid #e6c75d}.level-macro-badge.macro-below{background:#fde3e7;color:#7a2b3a;border:1px solid #e7a0aa}
+@media print{.report-meter{-webkit-print-color-adjust:exact;print-color-adjust:exact}.level-overview article,.level-macro-badge,.grade-matrix-value,.dept-metric-cell{-webkit-print-color-adjust:exact;print-color-adjust:exact}.level-overview{break-inside:avoid}.level-analysis-table .level-row{break-inside:avoid}}
