+.sr69-bars{display:grid;gap:.7rem}.sr69-bar-row{display:grid;grid-template-columns:minmax(115px,.9fr) minmax(110px,1.5fr) 92px;align-items:center;gap:.7rem;border:0;background:transparent;text-align:right;cursor:pointer}.sr69-bar-label b{display:block;color:#244b5a;font-size:.8rem}.sr69-bar-label small{display:block;margin-top:.1rem;color:#8b9ba2;font-size:.63rem}.sr69-bar-track{height:9px;border-radius:999px;background:#edf2f4;overflow:hidden}.sr69-bar-track i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#2a9f92,#64c5b9)}.sr69-bar-row.tone-mid .sr69-bar-track i{background:linear-gradient(90deg,#c38a24,#e0b252)}.sr69-bar-row.tone-low .sr69-bar-track i{background:linear-gradient(90deg,#c84c62,#e47d8d)}.sr69-bar-row>strong{text-align:left;color:#174454;font-size:.88rem}.sr69-bar-row>strong small{display:block;color:#81949b;font-size:.6rem;font-weight:700}
+.sr69-ring-grid{display:grid;grid-template-columns:1fr 1fr;gap:.85rem}.sr69-ring{--pct:0%;aspect-ratio:1;max-width:160px;margin:auto;border-radius:50%;display:grid;place-items:center;align-content:center;background:radial-gradient(circle at center,#fff 0 55%,transparent 56%),conic-gradient(#159b8a var(--pct),#edf2f4 0);box-shadow:inset 0 0 0 1px rgba(223,232,235,.7)}.sr69-ring.secondary{background:radial-gradient(circle at center,#fff 0 55%,transparent 56%),conic-gradient(#d69d34 var(--pct),#edf2f4 0)}.sr69-ring strong{color:#173f4f;font-size:1.3rem}.sr69-ring span{color:#83949b;font-size:.68rem}.sr69-readiness-list{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-top:.9rem}.sr69-readiness-list button{display:grid;gap:.2rem;border:1px solid #e4ebed;border-radius:11px;background:#f9fbfb;padding:.58rem;text-align:right}.sr69-readiness-list span{font-size:.63rem;color:#84959c}.sr69-readiness-list b{font-size:1rem;color:#244a59}
+.sr69-watch-list{display:grid;gap:.55rem}.sr69-watch-list>div{display:flex;justify-content:space-between;gap:.8rem;align-items:center;padding:.65rem .7rem;border:1px solid #e6ecee;border-right:4px solid #d49a2f;border-radius:11px;background:#fbfcfc}.sr69-watch-list>div.tone-low{border-right-color:#d65369;background:#fff8f9}.sr69-watch-list>div.tone-good,.sr69-watch-list>div.tone-excellent{border-right-color:#159b8a}.sr69-watch-list b{display:block;color:#244b59;font-size:.78rem}.sr69-watch-list small{display:block;color:#8798a0;font-size:.62rem;margin-top:.1rem}.sr69-watch-list strong{color:#193f4e}.sr69-teacher-grid{display:grid;g