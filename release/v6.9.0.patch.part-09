+ linear-gradient(180deg,#071e2e 0%,#0a2a3f 42%,#081b2b 100%)!important;
+ box-shadow:-18px 0 60px rgba(6,24,38,.14);border-left:1px solid rgba(255,255,255,.05)!important}
+.results-sidebar [data-sidebar="header"]{background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,0));position:relative;overflow:hidden}
+.results-sidebar [data-sidebar="header"]:after{content:"";position:absolute;width:180px;height:180px;border:1px solid rgba(255,255,255,.035);border-radius:50%;left:-90px;top:-92px;pointer-events:none}
+.results-sidebar .sidebar-nav-group{padding:.3rem;border-radius:1rem;transition:.2s ease}
+.results-sidebar .sidebar-nav-summary{width:100%;display:flex;align-items:center;gap:.55rem;padding:.55rem .75rem;color:rgba(255,255,255,.45);font-size:.72rem;font-weight:900;letter-spacing:.02em}
+.results-sidebar .sidebar-nav-summary span{flex:none}.results-sidebar .sidebar-nav-summary i{min-width:1.35rem;height:1.35rem;display:grid;place-items:center;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.045);border-radius:.5rem;color:rgba(255,255,255,.5);font-style:normal;font-size:.66rem}
+.results-sidebar [data-sidebar="menu-button"]{position:relative;overflow:hidden;border:1px solid transparent!important;border-radius:14px!important;margin-block:2px;min-height:45px}
+.results-sidebar [data-sidebar="menu-button"]:before{content:"";position:absolute;right:0;top:20%;bottom:20%;width:3px;border-radius:999px;background:transparent;transition:.2s ease}
+.results-sidebar [data-sidebar="menu-button"]:hover{background:rgba(255,255,255,.075)!important;border-color:rgba(255,255,255,.06)!important;transform:translateX(-2px)}
+.results-sidebar [data-sidebar="menu-button"][data-active="true"]{background:linear-gradient(90deg,rgba(255,255,255,.98),rgba(239,250,249,.96))!important;color:#102f3d!important;border-color:rgba(45,212,191,.24)!important;box-shadow:0 12px 30px rgba(0,0,0,.18),inset 0 0 0 1px rgba(255,255,255,.7)!important;transform:none}
+.results-sidebar [data-sidebar="menu-button"][data-active="true"]:before{background:linear-gradient(180deg,#2dd4bf,#d49a2f)}
+.results-sidebar [data-sidebar="menu-button"][data-active="true"] svg{filter:drop-shadow(0 3px 7px rgba(15,118,110,.18))}
+.results-sidebar [data-sidebar="footer"]{background:linear-gradient(0deg,rgba(0,0,0,.18),rgba(0,0,0,.03));backdrop-filter:blur(12px)}
+.results-sidebar input{border-radius:13px!important;box-shadow:inset 0 0 0 1px rgba(255,255,255,.02)}
+.results-sidebar input:focus{background:rgba(255,255,255,.11)!important}
+.sr69-sidebar-actions{display:grid;grid-template-columns:1fr 1fr;gap:.55rem;margin-top:.7rem}.sr69-sidebar-actions button{min-height:38px;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(255,255,255,.07);color:#fff;font-size:.75rem;font-weight:900;transition:.18s ease}.sr69-sidebar-actions button:first-child{background:linear-gradient(135deg,#16a394,#0d7f78);border-color:rgba(45,212,191,.35)}.sr69-sidebar-actions button:hover{transform:translateY(-1px);background:rgba(255,255,255,.12)}.sr69-sidebar-actions button:first-child:hover{background:linear-gradient(135deg,#18af9e,#0e8c83)}
+
+.sr69-dashboard{display:grid;gap:1.15rem}.sr69-command-hero{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr);gap:1.4rem;padding:1.6rem;border:1px solid rgba(10,76,91,.08);border-radius:26px;background:linear-gradient(125deg,#0c5360 0%,#0a6b6f 45%,#0f7f78 100%);box-shadow:0 18px 50px rgba(11,74,84,.14);color:#fff}.sr69-command-hero:before{content:"";position:absolute;inset:auto -90px -150px auto;width:380px;height:380px;border:54px solid rgba(255,255,255,.04);border-radius:50%}.sr69-command-hero:after{content:"";position:absolute;top:-120px;left:-90px;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(212,154,47,.24),rgba(212,154,47,0) 68%)}.sr69-hero-main,.sr69-cloud-summary{position:relative;z-index:1}.sr69-eyebrow{display:inline-flex;padding:.35rem .72rem;border:1px solid rgba(255,255,255,.16);border-radius:999px;background:rgba(255,255,255,.08);font-size:.78rem;font-weight:900;color:#fbe1a5}.sr69-hero-main h1{font-size:clamp(1.7rem,3vw,2.55rem);font-weight:1000;margin-top:.75rem;letter-spacing:-.02em}.sr69-hero-main p{margin-top:.45rem;color:rgba(255,255,255,.68);font-size:.95rem}.sr69-hero-actions{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.2rem}.sr69-hero-actions button{min-height:42px;padding:.55rem .95rem;border:1px solid rgba(255,255,255,.15);border-radius:12px;background:rgba(255,255,255,.08);color:#fff;font-size:.82rem;font-weight:900;transition:.18s ease}.sr69-hero-actions button:hover{transform:translateY(-1px);background:rgba(255,255,255,.14)}.sr69-hero-actions button.primary{background:#f3c961;color:#123247;border-color:#f3c961;box-shadow:0 8px 22px rgba(0,0,0,.13)}.sr69-cloud-summary{align-self:stretch;display:grid;align-content:center;gap:.42rem;padding:1.1rem 1.2rem;border:1px solid rgba(255,255,255,.12);border-radius:20px;background:linear-gradient(145deg,rgba(5,30,42,.22),rgba(255,255,255,.07));backdrop-filter:blur(10px)}.sr69-cloud-summary strong{font-size:1.35rem}.sr69-cloud-summary small{color:rgba(255,255,255,.6)}.sr69-cloud-status{display:flex;align-items:center;gap:.55rem;font-size:.82rem;font-weight:900}.sr69-cloud-status i{width:9px;height:9px;border-radius:50%;background:#4ade80;box-shadow:0 0 0 5px rgba(74,222,128,.1)}.sr69-cloud-status i.pending{background:#f4c756;box-shadow:0 0 0 5px rgba(244,199,86,.1)}.sr69-cloud-status i.bad{background:#fb7185;box-shadow:0 0 0 5px rgba(251,113,133,.1)}
+.sr69-kpi-strip{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.8rem}.sr69-kpi-strip article{position:relative;overflow:hidden;min-height:126px;padding:1rem 1.05rem;border:1px solid #dde8eb;border-radius:18px;background:#fff;box-shadow:0 8px 25px rgba(15,48,62,.055)}.sr69-kpi-strip article:before{content:"";position:absolute;right:0;top:0;bottom:0;width:4px;background:#0f766e}.sr69-kpi-strip article>span{display:block;color:#69808b;font-size:.76rem;font-weight:900}.sr69-kpi-strip article>strong{display:block;margin-top:.42rem;color:#163e4e;font-size:1.65rem;line-height:1.05}.sr69-kpi-strip article>small{display:block;margin-top:.42rem;color:#82949c;font-size:.72rem}.sr69-kpi-strip article.tone-low:before{background:#dd5268}.sr69-kpi-strip article.tone-mid:before{background:#d49a2f}.sr69-kpi-strip article.tone-excellent:before{background:#139987}.sr69-kpi-strip article.tone-navy:before{background:#295b73}.sr69-kpi-spark{position:absolute;left:1rem;right:1rem;bottom:.7rem;height:3px;border-radius:999px;background:#edf2f4}.sr69-kpi-spark:after{content:"";display:block;width:var(--spark);height:100%;border-radius:inherit;background:linear-gradient(90deg,#1da898,#d5a03a)}
+.sr69-filterbar{position:sticky;top:4.1rem;z-index:18;display:grid;grid-template-columns:repeat(4,minmax(135px,1fr)) auto;gap:.65rem;padding:.72rem;border:1px solid rgba(205,220,225,.86);border-radius:16px;background:rgba(255,255,255,.9);box-shadow:0 10px 26px rgba(14,53,67,.06);backdrop-filter:blur(14px)}.sr69-filter{display:grid;gap:.28rem}.sr69-filter>span{font-size:.7rem;color:#71858f;font-weight:900}.sr69-filter select{height:40px;border:1px solid #dfe8eb;border-radius:11px;background:#f8fbfb;padding:0 .7rem;color:#264b5a;font-size:.82rem;font-weight:800}.sr69-filterbar .reset{align-self:end;height:40px;border-radius:11px;background:#eff5f6;color:#345563;font-size:.78rem;font-weight:900;padding:0 .85rem}
+.sr69-top-charts,.sr69-mid-grid,.sr69-bottom-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(340px,.75fr);gap:1rem}.sr69-mid-grid{grid-template-columns:minmax(0,1.1fr) minmax(340px,.9fr)}.sr69-bottom-grid{grid-template-columns:minmax(0,1.35fr) minmax(320px,.65fr)}.sr69-panel{min-width:0;padding:1.05rem;border:1px solid #dde8eb;border-radius:20px;background:#fff;box-shadow:0 8px 28px rgba(15,48,62,.05)}.sr69-panel>header{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:.9rem}.sr69-panel>header span{display:block;color:#8a9aa2;font-size:.68rem;font-weight:900}.sr69-panel>header h2{margin-top:.15rem;color:#173f4f;font-size:1rem;font-weight:1000}.sr69-panel>header>b,.sr69-panel>header>small{padding:.35rem .55rem;border-radius:9px;background:#f1f6f7;color:#486672;font-size:.72rem}.sr69-panel>header>button{border:1px solid #dfe9ec;border-radius:10px;background:#f7fafb;padding:.42rem .65rem;color:#2f5967;font-size:.72rem;font-weight:900}
+.sr69-chart-shell{display:grid;gap:.4rem}.sr69-chart-legend{display:flex;gap:1rem;justify-content:flex-start}.sr69-chart-legend span{display:flex;align-items:center;gap:.35rem;font-size:.72rem;color:#667e88;font-weight:900}.sr69-chart-legend i{width:9px;height:9px;border-radius:50%}.sr69-chart-legend .success i{background:#159b8a}.sr69-chart-legend .achievement i{background:#d69d34}.sr69-line-chart{width:100%;height:auto;min-height:225px}.sr69-line-chart .grid-line{stroke:#e8eef0;stroke-width:1}.sr69-line-chart .axis-label{fill:#91a0a6;font-size:10px}.sr69-line-chart .trend-line{fill:none;stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round}.sr69-line-chart .trend-line.success{stroke:#159b8a}.sr69-line-chart .trend-line.achievement{stroke:#d69d34}.sr69-line-chart .dot{stroke:#fff;stroke-width:3}.sr69-line-chart .dot.success{fill:#159b8a}.sr69-line-chart .dot.achievement{fill:#d69d34}.sr69-chart-labels{display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem}.sr69-chart-labels>div{text-align:center}.sr69-chart-labels b{display:block;color:#345663;font-size:.72rem}.sr69-chart-labels small{display:block;color:#86969d;font-size:.66rem;margin-top:.12rem}
+.sr69-grade-bars{display:flex;align-items:flex-end;gap:.65rem;min-height:260px;padding:.65rem .2rem 0}.sr69-grade-bars article{flex:1;min-width:72px;display:grid;grid-template-rows:auto 180px auto;gap:.45rem}.sr69-grade-bars header{display:flex;justify-content:space-between;gap:.35rem;align-items:center}.sr69-grade-bars header b{font-size:.78rem;color:#264b5a}.sr69-grade-bars header span{font-size:.65rem;color:#83949b}.sr69-grade-pair{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:.35rem;border-bottom:1px solid #dfe7ea;padding:0 .2rem}.sr69-grade-pair>div{height:100%;display:flex;align-items:flex-end;background:linear-gradient(180deg,rgba(244,248,249,.25),rgba(244,248,249,.7));border-radius:8px 8px 0 0;overflow:hidden}.sr69-grade-pair i{display:block;width:100%;min-height:3px;border-radius:7px 7px 0 0}.sr69-grade-pair i.success{background:linear-gradient(180deg,#39b7a9,#148d80)}.sr69-grade-pair i.achievement{background:linear-gradient(180deg,#efc86f,#cf922a)}.sr69-grade-bars footer{display:grid;gap:.12rem;color:#748890;font-size:.62rem}
