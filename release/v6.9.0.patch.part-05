   const addClass=async()=>{const grade=c.grades.find(g=>g.id===classGrade);if(!grade)return eb.error('اختر الصف الدراسي.');const normalized=lj(className);if(!normalized)return eb.error('اكتب اسم الشعبة، مثل 7/1.');if(c.classes.some(x=>ij(x.className)===ij(normalized)&&x.active!==false))return eb.error('الشعبة موجودة بالفعل.');await save('إضافة شعبة',(cat,current)=>{const cls={id:SR63.stableId('class',ij(normalized)),name:normalized,className:normalized,gradeId:grade.id,grade:grade.name,order:cat.classes.length+1,active:true},assignments=[...cat.teacherAssignments];for(const subject of cat.subjects.filter(s=>s.active!==false&&(!s.gradeIds.length||s.gradeIds.includes(grade.id)))){const profileId=classTeachers[subject.id];if(!profileId)continue;const teacher=cat.teachers.find(t=>t.id===profileId);if(teacher)assignments.push({id:SR63.stableId('assignment',`${profileId}|${subject.id}|${cls.id}`),profileId,teacher:teacher.teacher,subjectId:subject.id,subject:subject.name,department:subject.department,classId:cls.id,className:cls.className,gradeId:grade.id,grade:grade.name,active:true});}return {...current,...cat,classes:[...cat.classes,cls],teacherAssignments:assignments};});setClassName('');setClassTeachers({});eb.success('تمت إضافة الشعبة وربط المعلمين المختارين.');};
   const addTeacher=async()=>{const name=teacherName.trim();if(!name)return eb.error('اكتب اسم المعلم.');if(!teacherSubjects.size||!teacherClasses.size)return eb.error('اختر مادة واحدة وشعبة واحدة على الأقل.');const duplicate=c.teachers.some(t=>ij(t.teacher)===ij(name)&&t.active!==false);if(duplicate)return eb.error('المعلم موجود بالفعل؛ عدّل تكليفاته من خريطة التكليفات.');await save('إضافة معلم وتكليفاته',(cat,current)=>{const id=`profile-${crypto.randomUUID()}`,profile={id,teacherId:teacherId.trim()||`T-${String(cat.teachers.length+1).padStart(3,'0')}`,teacher:name,subject:'',department:'',coordinator:'',subjects:[],classes:[],active:true},assignments=[...cat.teacherAssignments];for(const subjectId of teacherSubjects)for(const classId of teacherClasses){const subject=cat.subjects.find(s=>s.id===subjectId),cls=cat.classes.find(x=>x.id===classId);if(!subject||!cls||subject.active===false||cls.active===false||subject.gradeIds.length&&!subject.gradeIds.includes(cls.gradeId))continue;assignments.splice(0,assignments.length,...assignments.filter(a=>!(a.classId===classId&&a.subjectId===subjectId)));assignments.push({id:SR63.stableId('assignment',`${id}|${subjectId}|${classId}`),profileId:id,teacher:name,subjectId,subject:subject.name,department:subject.department,classId,className:cls.className,gradeId:cls.gradeId,grade:cls.grade,active:true});}return {...current,...cat,teachers:[...cat.teachers,profile],teacherAssignments:assignments};});setTeacherId('');setTeacherName('');setTeacherSubjects(new Set);setTeacherClasses(new Set);eb.success('تمت إضافة المعلم وربط تكليفاته.');};
   const removeEntity=async(type,item)=>{const labels={grade:'الصف',class:'الشعبة',subject:'المادة',teacher:'المعلم'},label=labels[type];if(!window.confirm(`حذف ${label} «${item.name||item.className||item.teacher}» من الهيكل الحالي؟ النتائج التاريخية لن تُحذف.`))return;await save(`حذف ${label}`,(cat,current)=>{let grades=cat.grades,classes=cat.classes,subjects=cat.subjects,teachers=cat.teachers,teacherAssignments=cat.teacherAssignments;if(type==='grade'){const used=current.rows.some(r=>ij(r.grade)===ij(item.name))||classes.some(x=>x.gradeId===item.id);grades=used?grades.map(g=>g.id===item.id?{...g,active:false}:g):grades.filter(g=>g.id!==item.id);if(used)classes=classes.map(x=>x.gradeId===item.id?{...x,active:false}:x);}if(type==='class'){const used=current.rows.some(r=>ij(r.className)===ij(item.className));classes=used?classes.map(x=>x.id===item.id?{...x,active:false}:x):classes.filter(x=>x.id!==item.id);teacherAssignments=teacherAssignments.filter(a=>a.classId!==item.id);}if(type==='subject'){const used=current.rows.some(r=>ij(r.subject)===ij(item.name));subjects=used?subjects.map(s=>s.id===item.id?{...s,active:false}:s):subjects.filter(s=>s.id!==item.id);teacherAssignments=teacherAssignments.filter(a=>a.subjectId!==item.id);}if(type==='teacher'){teachers=teachers.filter(t=>t.id!==item.id);teacherAssignments=teacherAssignments.filter(a=>a.profileId!==item.id);}return {...current,...cat,grades,classes,subjects,teachers,teacherAssignments};});eb.success(`تم تحديث ${label} مع الحفاظ على النتائج التاريخية.`);};
   const editTeacher=async teacher=>{const name=window.prompt('اسم المعلم',teacher.teacher);if(name===null)return;const code=window.prompt('الرقم التعريفي للمعلم',teacher.teacherId||'');if(code===null)return;if(!name.trim())return eb.error('اسم المعلم مطلوب.');await save('تعديل بيانات معلم',(cat,current)=>({...current,...cat,teachers:cat.teachers.map(t=>t.id===teacher.id?{...t,teacher:name.trim(),teacherId:code.trim()||t.teacherId}:t),teacherAssignments:cat.teacherAssignments.map(a=>a.profileId===teacher.id?{...a,teacher:name.trim()}:a)}));};
+  const editSubject=async subject=>{const department=window.prompt('القسم / المجال',subject.department||subject.name);if(department===null)return;const coordinator=window.prompt('اسم منسق المادة',SR63.subjectCoordinator({...workspace,...c},subject.name)||'');if(coordinator===null)return;await save(`تعديل مادة ${subject.name}`,(cat,current)=>({...current,...cat,subjects:cat.subjects.map(s=>s.id===subject.id?{...s,department:department.trim()||s.name,coordinatorName:coordinator.trim(),coordinatorId:''}:s),teacherAssignments:cat.teacherAssignments.map(a=>a.subjectId===subject.id?{...a,department:department.trim()||subject.name}:a)}));eb.success('تم تحديث بيانات المادة ومنسقها.');};
